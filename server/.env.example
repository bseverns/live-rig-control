# WebSocket server port for the browser to connect to
WSS_PORT=9001
BIND_HOST=127.0.0.1
MAX_WS_PAYLOAD_BYTES=4096
RATE_WINDOW_MS=5000
MAX_MESSAGES_PER_WINDOW=500
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
BRIDGE_TOKEN=

# OSC target host and port (e.g. your video engine or DAW OSC input)
OSC_HOST=127.0.0.1
OSC_PORT=9000
