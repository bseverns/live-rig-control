{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/live-rig-control/interop.schema.json",
  "title": "Live Rig Control Mappings Interop",
  "type": "object",
  "required": [
    "profiles"
  ],
  "properties": {
    "interopVersion": {
      "type": "string"
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "profile": {
      "type": "object",
      "required": [
        "pads"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "section": {
          "type": "string",
          "enum": [
            "show",
            "sound",
            "video",
            "setup"
          ]
        },
        "order": {
          "type": "integer"
        },
        "layout": {
          "$ref": "#/$defs/layout"
        },
        "gridSize": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "pads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pad"
          }
        }
      },
      "additionalProperties": false
    },
    "pad": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "row": {
          "type": "integer",
          "minimum": 0
        },
        "col": {
          "type": "integer",
          "minimum": 0
        },
        "toggle": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": [
            "toggle",
            "momentary"
          ]
        },
        "group": {
          "$ref": "#/$defs/group"
        },
        "midi": {
          "$ref": "#/$defs/midiMapping"
        },
        "osc": {
          "$ref": "#/$defs/oscMapping"
        },
        "ui": {
          "$ref": "#/$defs/uiMapping"
        },
        "state": {
          "$ref": "#/$defs/stateMapping"
        },
        "notes": {
          "type": "string"
        },
        "risk": {
          "$ref": "#/$defs/risk"
        },
        "queuePolicy": {
          "$ref": "#/$defs/queuePolicy"
        },
        "queueTtlMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "midi"
          ]
        },
        {
          "required": [
            "osc"
          ]
        },
        {
          "required": [
            "ui"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "allOf": [
              {
                "required": [
                  "toggle"
                ],
                "properties": {
                  "toggle": {
                    "const": true
                  }
                }
              },
              {
                "not": {
                  "required": [
                    "ui"
                  ],
                  "properties": {
                    "ui": {
                      "required": [
                        "type"
                      ],
                      "properties": {
                        "type": {
                          "const": "slider"
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "then": {
            "properties": {
              "osc": {
                "required": [
                  "onArgs",
                  "offArgs"
                ]
              }
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "required": [
                  "mode"
                ],
                "properties": {
                  "mode": {
                    "const": "toggle"
                  }
                }
              },
              {
                "not": {
                  "required": [
                    "ui"
                  ],
                  "properties": {
                    "ui": {
                      "required": [
                        "type"
                      ],
                      "properties": {
                        "type": {
                          "const": "slider"
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "then": {
            "properties": {
              "osc": {
                "required": [
                  "onArgs",
                  "offArgs"
                ]
              }
            }
          }
        }
      ]
    },
    "layout": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "performanceDeck",
            "parameterBoard",
            "mappedGrid"
          ]
        },
        "minCardWidth": {
          "type": "integer",
          "minimum": 80,
          "maximum": 320
        },
        "riskDisplay": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "queuePolicy": {
      "type": "string",
      "enum": [
        "never",
        "latest",
        "ttl",
        "safety"
      ]
    },
    "group": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "mode": {
              "type": "string",
              "enum": [
                "exclusive"
              ]
            },
            "exclusive": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "oscArg": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "oscArgs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/oscArg"
      }
    },
    "oscMapping": {
      "type": "object",
      "required": [
        "address"
      ],
      "properties": {
        "address": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "$ref": "#/$defs/oscArgs"
        },
        "onArgs": {
          "$ref": "#/$defs/oscArgs"
        },
        "offArgs": {
          "$ref": "#/$defs/oscArgs"
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "args"
          ]
        },
        {
          "required": [
            "onArgs"
          ]
        }
      ]
    },
    "stateMapping": {
      "type": "object",
      "properties": {
        "query": {
          "$ref": "#/$defs/oscAction"
        },
        "publish": {
          "$ref": "#/$defs/oscAction"
        }
      },
      "additionalProperties": false
    },
    "oscAction": {
      "type": "object",
      "required": [
        "address"
      ],
      "properties": {
        "address": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "$ref": "#/$defs/oscArgs"
        }
      },
      "additionalProperties": false
    },
    "midiMapping": {
      "type": "object",
      "required": [
        "type",
        "channel"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "note",
            "cc",
            "program",
            "realtime"
          ]
        },
        "channel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "note": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "cc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "onVelocity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "offVelocity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "onValue": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "offValue": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "program": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "bankMsb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "bankLsb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "programBankMode": {
          "type": "string",
          "enum": [
            "electribePattern"
          ]
        },
        "realtime": {
          "type": "string",
          "enum": [
            "start",
            "continue",
            "stop"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "note"
              }
            }
          },
          "then": {
            "required": [
              "note"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "cc"
              }
            }
          },
          "then": {
            "required": [
              "cc"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "program"
              }
            }
          },
          "then": {
            "required": [
              "program"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "realtime"
              }
            }
          },
          "then": {
            "required": [
              "realtime"
            ]
          }
        }
      ]
    },
    "uiMapping": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "button",
            "slider"
          ]
        },
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        },
        "step": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        },
        "initial": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "showValue": {
          "type": "boolean"
        },
        "role": {
          "type": "string",
          "enum": [
            "velocity",
            "velocityOverride",
            "pattern",
            "patternBank"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "bank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    }
  }
}
